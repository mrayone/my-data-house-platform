# Copie para .env e ajuste conforme seu ambiente local. Nunca versione .env
# (está no .gitignore). Nenhum valor abaixo é um segredo real.

# DSN de conexão com o ClickHouse. Ex.: clickhouse://localhost:9000/default
CLICKHOUSE_DSN=clickhouse://localhost:9000/default

# Lista de brokers Kafka separada por vírgula. Ex.: localhost:9092
KAFKA_BROKERS=localhost:9092

# Endereço HTTP do Confluent Schema Registry.
SCHEMA_REGISTRY_URL=http://localhost:8081

# Endereço HTTP da API REST do Kafka Connect.
CONNECT_URL=http://localhost:8083

# Nível de log: debug|info|warn|error. Opcional — default "info".
LOG_LEVEL=info
