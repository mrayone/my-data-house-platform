{
  "_generated_from": "contracts/domains/customer/customer.yaml (spike Fase 03 — manual; definitivo vem de dhctl generate)",
  "name": "dh-sink-customer-customer",
  "config": {
    "connector.class": "com.clickhouse.kafka.connect.ClickHouseSinkConnector",
    "tasks.max": "1",
    "topics": "sap.customer.customer.v1",
    "hostname": "clickhouse",
    "port": "8123",
    "database": "dh_landing",
    "username": "default",
    "password": "${CLICKHOUSE_PASSWORD}",
    "topic2TableMap": "sap.customer.customer.v1=customer__customer_raw",
    "exactlyOnce": "true",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "dh-dlq-sap.customer.customer.v1",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true"
  }
}
