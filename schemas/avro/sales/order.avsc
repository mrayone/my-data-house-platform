{
  "type": "record",
  "name": "order_value",
  "namespace": "mdh.sales",
  "doc": "GERADO (spike) a partir de contracts/domains/sales/order.yaml — espelha dh_landing.sales__order_raw (menos _ingested_at, DEFAULT na tabela). Decimais e timestamps como string: mesmo formato JSONEachRow validado no spike.",
  "fields": [
    {
      "name": "order_id",
      "type": "string"
    },
    {
      "name": "customer_id",
      "type": "string"
    },
    {
      "name": "business_unit_code",
      "type": "string"
    },
    {
      "name": "order_status",
      "type": "string"
    },
    {
      "name": "channel",
      "type": "string"
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "discount_code",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "gross_amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 18,
        "scale": 4
      }
    },
    {
      "name": "discount_amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 18,
        "scale": 4
      }
    },
    {
      "name": "freight_amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 18,
        "scale": 4
      }
    },
    {
      "name": "total_amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 18,
        "scale": 4
      }
    },
    {
      "name": "created_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "updated_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "_topic",
      "type": "string"
    },
    {
      "name": "_partition",
      "type": "int"
    },
    {
      "name": "_offset",
      "type": "long"
    },
    {
      "name": "_kafka_ts",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "_op",
      "type": "string"
    },
    {
      "name": "_cdc_seq",
      "type": "long"
    },
    {
      "name": "_schema_id",
      "type": "int"
    }
  ]
}
